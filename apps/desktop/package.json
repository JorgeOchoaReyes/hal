{
  "name": "@hal/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "HAL desktop app — an Electron shell around the HAL web app for a local, self-contained voice AI test lab.",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json && HAL_WEB_URL=${HAL_WEB_URL:-http://localhost:3000} electron .",
    "start": "electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "package": "electron-builder",
    "clean": "rm -rf dist .turbo release"
  },
  "dependencies": {
    "@hal/web": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "typescript": "^5.6.3"
  },
  "build": {
    "appId": "ai.hal.desktop",
    "productName": "HAL",
    "files": ["dist/**", "node_modules/**"],
    "directories": { "output": "release" }
  }
}
