{
  "name": "@hal/desktop",
  "version": "0.1.4",
  "private": true,
  "description": "HAL desktop app — an Electron shell around the HAL web app for a local, self-contained voice AI test lab.",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json && HAL_WEB_URL=${HAL_WEB_URL:-http://localhost:3000} electron .",
    "start": "electron .",
    "smoke": "tsc -p tsconfig.json && HAL_WEB_URL=${HAL_WEB_URL:-http://localhost:3000} HAL_SCREENSHOT=${HAL_SCREENSHOT:-hal-desktop.png} xvfb-run -a electron --no-sandbox --disable-gpu .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "stage:web": "pnpm --filter @hal/web... build && node scripts/stage-web.mjs",
    "smoke:server": "pnpm stage:web && node scripts/smoke-server.mjs",
    "package": "pnpm build && pnpm stage:web && electron-builder",
    "release": "pnpm build && pnpm stage:web && electron-builder --publish always",
    "clean": "rm -rf dist .turbo release resources"
  },
  "dependencies": {
    "@hal/web": "workspace:*",
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "typescript": "^5.6.3"
  },
  "build": {
    "appId": "ai.hal.desktop",
    "productName": "HAL",
    "electronVersion": "33.4.11",
    "files": ["dist/**", "node_modules/**"],
    "extraResources": [{ "from": "resources/web", "to": "web" }],
    "directories": { "output": "release" },
    "publish": [{ "provider": "github", "owner": "JorgeOchoaReyes", "repo": "hal", "releaseType": "release" }],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": ["dmg", "zip"],
      "identity": null,
      "gatekeeperAssess": false
    },
    "dmg": { "writeUpdateInfo": false },
    "win": { "target": ["nsis"] },
    "linux": { "target": ["AppImage"], "category": "Development" }
  }
}
