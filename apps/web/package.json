{
  "name": "@hal/web",
  "version": "0.1.0",
  "private": true,
  "description": "HAL self-hostable web app: create scenarios, run test calls, view transcripts and pass/fail verdicts.",
  "scripts": {
    "dev": "next dev -p ${PORT:-3000}",
    "build": "next build",
    "start": "next start -p ${PORT:-3000}",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf .next .turbo out",
    "test": "node --test --import tsx src/lib/__tests__/*.test.ts",
    "smoke:results": "node scripts/smoke-results.mjs"
  },
  "dependencies": {
    "@hal/core": "workspace:*",
    "@hal/media": "workspace:*",
    "next": "^15.1.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "typescript": "^5.6.3",
    "tsx": "^4.19.2"
  }
}
