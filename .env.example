# ---------------------------------------------------------------------------
# HAL environment configuration
# Copy to .env and fill in the providers you actually want to use.
# Everything works in "mock" mode with no keys at all.
# ---------------------------------------------------------------------------

# --- LLM providers (used by the testing agent persona AND the judge) ---------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Speech (only needed for real audio calls, not text/mock mode) ----------
DEEPGRAM_API_KEY=

# --- Telephony (Twilio) — only needed for real PSTN test calls --------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Publicly reachable base URL of this HAL instance, used for Twilio webhooks
# and WebRTC signaling callbacks. e.g. https://hal.example.com
HAL_PUBLIC_URL=http://localhost:3000

# --- Web app ----------------------------------------------------------------
PORT=3000
