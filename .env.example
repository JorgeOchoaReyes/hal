# ---------------------------------------------------------------------------
# HAL environment configuration
# Copy to .env and fill in the providers you actually want to use.
# Everything works in "mock" mode with no keys at all.
# ---------------------------------------------------------------------------

# --- LLM providers (used by the testing agent persona AND the judge) ---------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Speech (only needed for real audio calls, not text/mock mode) ----------
DEEPGRAM_API_KEY=

# --- Telephony (Twilio) — only needed for real PSTN test calls --------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Publicly reachable base URL of this HAL instance, used for Twilio webhooks
# and WebRTC signaling callbacks. e.g. https://hal.example.com
HAL_PUBLIC_URL=http://localhost:3000

# --- Web app ----------------------------------------------------------------
PORT=3000

# --- Persistence ------------------------------------------------------------
# Where simulations and run results are stored. Default: ./data
HAL_DATA_DIR=./data
# Storage backend: "sqlite" (default, via Node's built-in node:sqlite — needs
# Node >= 22.5) or "json" to force the plain JSON-file fallback.
HAL_DB=sqlite

# --- Real-audio media plane -------------------------------------------------
# Twilio PSTN media server (auto-starts when the TWILIO_* vars above are set).
HAL_MEDIA_PORT=8787
# WebRTC/SIP media gateway (auto-starts when DEEPGRAM_API_KEY is set).
# Set to "off" to disable it.
HAL_MEDIA_GATEWAY=on
HAL_GATEWAY_PORT=8788

# --- Desktop app ------------------------------------------------------------
# URL the Electron shell loads in dev (defaults to the web app above).
HAL_WEB_URL=http://localhost:3000
