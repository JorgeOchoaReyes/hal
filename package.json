{
  "name": "hal",
  "version": "0.1.0",
  "private": true,
  "description": "HAL — a local / self-hostable service for testing voice AI agents by placing simulated test calls and judging pass/fail.",
  "license": "MIT",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean && rm -rf node_modules",
    "web": "turbo run dev --filter=@hal/web",
    "desktop": "turbo run dev --filter=@hal/desktop"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "turbo": "^2.3.3",
    "typescript": "^5.6.3"
  }
}
